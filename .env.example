# Copia questo file in ".env" (per lo sviluppo locale) e inserisci i valori reali.
# Il file .env NON va mai caricato su GitHub (è già escluso in .gitignore).
# In produzione imposta queste variabili nel pannello di Vercel:
# Project → Settings → Environment Variables.

# Chiave segreta Stripe (Dashboard Stripe → Sviluppatori → Chiavi API). In test inizia con sk_test_
STRIPE_SECRET_KEY=

# Indirizzo pubblico del sito: solo il dominio, con https:// (es. https://diana.vercel.app).
# Eventuali percorsi o "/" finali vengono ignorati. Se manca, si usa il dominio di produzione Vercel.
SITE_URL=
